Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Classes\*\shell\EasyRemoveBG.RemoveBackground]
@="Remove Background"
"Icon"="py.exe"

[HKEY_CURRENT_USER\Software\Classes\*\shell\EasyRemoveBG.RemoveBackground\command]
@="py -m easyremovebg.cli remove-bg \"%1\""

[HKEY_CURRENT_USER\Software\Classes\*\shell\EasyRemoveBG.RemoveLogoBackground]
@="Remove Logo Background"
"Icon"="py.exe"

[HKEY_CURRENT_USER\Software\Classes\*\shell\EasyRemoveBG.RemoveLogoBackground\command]
@="py -m easyremovebg.cli remove-logo \"%1\""
